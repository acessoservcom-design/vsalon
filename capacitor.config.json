{
  "appId": "com.vbarber.painel",
  "appName": "vBarber",
  "webDir": "apk-web",
  "server": {
    "url": "https://vsalon.web.app/",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#141414",
      "androidSplashResourceName": "splash"
    }
  }
}
